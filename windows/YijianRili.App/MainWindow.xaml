<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="YijianRili.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="一键日历">

    <Grid x:Name="RootGrid" Padding="16" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="一键日历" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="?" ToolTipService.ToolTip="同步帮助"
                    Click="HelpButton_Click" Width="36"/>
            <ComboBox x:Name="ThemeCombo" Grid.Column="2" Width="110"
                      SelectionChanged="ThemeCombo_SelectionChanged"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Text="日程" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <Button Content="昨天" Click="Yesterday_Click" Padding="8,4"/>
                                <Button Content="今天" Click="Today_Click" Padding="8,4"/>
                                <Button Content="明天" Click="Tomorrow_Click" Padding="8,4"/>
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="DayEventsList" MaxHeight="140" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Title}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <RadioButton x:Name="ReviewModeRadio" Content="复习计划" Checked="ReviewMode_Checked"/>
                    <RadioButton x:Name="SingleModeRadio" Content="单次日程" Checked="SingleMode_Checked"/>
                </StackPanel>

                <TextBox x:Name="TitleBox" Header="标题"
                         PlaceholderText="例如：复习英语单词"
                         MaxLength="100"
                         TextChanged="TitleBox_TextChanged"/>

                <CalendarDatePicker x:Name="BaseDatePicker" Header="基准日期"
                                   DateChanged="BaseDatePicker_DateChanged"/>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="IntervalSummaryText"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="经典" Click="PresetClassic_Click"/>
                        <Button Content="考试" Click="PresetExam_Click"/>
                        <Button Content="日常" Click="PresetDaily_Click"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="复习预览" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="PreviewTextBlock" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <ComboBox x:Name="CalendarCombo" Header="写入日历"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="CalendarCombo_SelectionChanged"
                          HorizontalAlignment="Stretch"/>
                <InfoBar x:Name="LocalWarningBar"
                         Severity="Warning"
                         Title="本地日历"
                         Message="本地事件不会同步到手机。请添加 Outlook 或 Google 账户。"
                         IsOpen="False"/>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CreateButton" Grid.Column="0" Content="一键创建"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Create_Click"
                            HorizontalAlignment="Stretch"/>
                    <Button x:Name="UndoButton" Grid.Column="1" Content="撤销"
                            Click="Undo_Click" IsEnabled="False"/>
                    <Button x:Name="RecreateButton" Grid.Column="2" Content="再建一个"
                            Click="Recreate_Click" IsEnabled="False"/>
                </Grid>

                <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap"/>

                <ToggleSwitch x:Name="FloatingToggle" Header="窗口置顶"
                              Toggled="FloatingToggle_Toggled"/>

                <Expander Header="历史记录" HorizontalAlignment="Stretch">
                    <ListView x:Name="HistoryList"
                              MaxHeight="160"
                              IsItemClickEnabled="True"
                              ItemClick="History_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="快捷键：Ctrl+Enter 创建"
                   Opacity="0.55" FontSize="12" HorizontalAlignment="Center"/>
    </Grid>
</Window>
