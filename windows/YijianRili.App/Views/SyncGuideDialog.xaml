<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="YijianRili.App.Views.SyncGuideDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="配置云日历以同步到手机"
    PrimaryButtonText="打开 Windows 设置"
    SecondaryButtonText="打开日历"
    CloseButtonText="我知道了"
    DefaultButton="Close"
    PrimaryButtonClick="OpenSettings_Click"
    SecondaryButtonClick="OpenCalendar_Click">

    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
            <TextBlock TextWrapping="Wrap" Opacity="0.85"
                       Text="一键日历会把复习日程写入你选择的系统日历。只有写入 Outlook、Google 等云账户时，手机才能同步看到。"/>

            <Pivot>
                <PivotItem Header="Outlook">
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <TextBlock FontWeight="SemiBold" Text="推荐：Outlook.com / Microsoft 365"/>
                        <TextBlock TextWrapping="Wrap" Text="1. 打开「设置 → 账户 → 电子邮件和账户」，添加 Microsoft 账户。"/>
                        <TextBlock TextWrapping="Wrap" Text="2. 打开系统「日历」应用，确认该账户下的日历已显示且可写入。"/>
                        <TextBlock TextWrapping="Wrap" Text="3. 回到一键日历，在「写入日历」中选择 Outlook 日历（不要选本地）。"/>
                        <TextBlock TextWrapping="Wrap" Text="4. 手机安装 Outlook 或使用同一 Microsoft 账户登录系统日历，即可看到复习提醒。"/>
                    </StackPanel>
                </PivotItem>
                <PivotItem Header="Google">
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <TextBlock FontWeight="SemiBold" Text="备选：Google 日历"/>
                        <TextBlock TextWrapping="Wrap" Text="1. 在 Windows「设置 → 账户」添加 Google 账户，并开启日历同步。"/>
                        <TextBlock TextWrapping="Wrap" Text="2. 打开系统「日历」应用，确认 Google 日历可见。"/>
                        <TextBlock TextWrapping="Wrap" Text="3. 在一键日历中选择该 Google 日历后创建日程。"/>
                        <TextBlock TextWrapping="Wrap" Text="4. 手机使用同一 Google 账户打开「日历」App。"/>
                    </StackPanel>
                </PivotItem>
                <PivotItem Header="说明">
                    <StackPanel Spacing="10" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" Text="与 macOS 版不同：Windows 系统日历对 163 / 139 等第三方 CalDAV 支持较弱，因此本引导优先 Outlook 与 Google。"/>
                        <TextBlock TextWrapping="Wrap" Text="本地日历可以创建，但不会同步到手机；界面会显示黄色警告。"/>
                        <TextBlock TextWrapping="Wrap" Text="全天复习事件会写入备注「第N次复习」。Windows 日历对全天事件的定点 09:00 提醒能力有限，可在系统日历中按需补提醒。"/>
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
